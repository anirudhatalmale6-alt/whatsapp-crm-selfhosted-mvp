# =============================================================================
#  MVP CRM WhatsApp - variables de la plataforma
#  Copiar a  .env  y rellenar.  NUNCA subir el .env real a git.
# =============================================================================

# --- dominios (3 subdominios apuntando al VPS por registro A) ----------------
CRM_HOST=crm.tudominio.com          # Chatwoot: lo usa el equipo comercial
N1_HOST=wa1.tudominio.com           # API del numero 1 (uso interno)
N2_HOST=wa2.tudominio.com           # API del numero 2 (uso interno)
ACME_EMAIL=avisos@tudominio.com     # para los certificados Let's Encrypt

# --- versiones fijadas (nada de :latest en produccion) -----------------------
POSTGRES_IMAGE=pgvector/pgvector:0.8.6-pg16
TRAEFIK_IMAGE=traefik:v3.7.10
EVOLUTION_IMAGE=evoapicloud/evolution-api:v2.3.7
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.16.2-ce

# --- base de datos -----------------------------------------------------------
POSTGRES_USER=wacrm
POSTGRES_PASSWORD=CAMBIAME_password_largo_postgres

# --- NUMERO 1 ----------------------------------------------------------------
N1_INSTANCE=ventas1
N1_API_KEY=CAMBIAME_clave_api_numero_1
N1_PROXY_HOST=
N1_PROXY_PORT=
N1_PROXY_PROTOCOL=http               # http | https | socks5
N1_PROXY_USERNAME=
N1_PROXY_PASSWORD=

# --- NUMERO 2 ----------------------------------------------------------------
N2_INSTANCE=ventas2
N2_API_KEY=CAMBIAME_clave_api_numero_2
N2_PROXY_HOST=
N2_PROXY_PORT=
N2_PROXY_PROTOCOL=http
N2_PROXY_USERNAME=
N2_PROXY_PASSWORD=

# --- identidad del "navegador" que ve WhatsApp en Dispositivos vinculados ----
SESSION_PHONE_CLIENT="CRM Comercial"
SESSION_PHONE_NAME=Chrome

# --- enlace con Chatwoot -----------------------------------------------------
# Se rellenan DESPUES de crear el usuario admin del CRM:
#   Ajustes > Perfil > Access Token   y el numero de cuenta que sale en la URL
CW_ACCOUNT_ID=1
CW_TOKEN=

# --- vigilancia --------------------------------------------------------------
WATCH_INTERVAL=60
# Avisos por Telegram. Crear el bot con @BotFather (/newbot) y ESCRIBIRLE una
# vez desde la cuenta que va a recibir los avisos: un bot no puede iniciar la
# conversacion. El chat_id se saca con:
#   curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates"
ALERT_TELEGRAM_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Webhook generico para cualquier otro destino (Slack, Discord, n8n...). Recibe
# un JSON {"text","content","message"} con el mismo aviso.
# OJO: Telegram NO vale aqui. Su API exige chat_id ademas del texto, asi que
# pegar su URL en este hueco devuelve 400 y el aviso se pierde sin dar error.
# Para Telegram usar las dos variables de arriba. Se pueden usar ambos a la vez.
ALERT_WEBHOOK_URL=
