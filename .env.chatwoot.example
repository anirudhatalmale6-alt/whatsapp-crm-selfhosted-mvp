# =============================================================================
#  Chatwoot (CRM / bandeja del equipo)  -> copiar a .env.chatwoot
#  SECRET_KEY_BASE:  openssl rand -hex 64
# =============================================================================
RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

SECRET_KEY_BASE=CAMBIAME_openssl_rand_hex_64
FRONTEND_URL=https://crm.tudominio.com
FORCE_SSL=true
DEFAULT_LOCALE=es

# --- base de datos (el mismo Postgres, base separada) ------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=wacrm
POSTGRES_PASSWORD=CAMBIAME_password_largo_postgres

# --- redis (indice 0, separado de los indices 1 y 2 de los numeros) ----------
REDIS_URL=redis://redis:6379/0

# --- registro cerrado: solo el admin da de alta agentes ----------------------
ENABLE_ACCOUNT_SIGNUP=false

# --- almacenamiento local en disco (sin S3 en el MVP) ------------------------
ACTIVE_STORAGE_SERVICE=local

# --- correo saliente (invitaciones a agentes, avisos) ------------------------
MAILER_SENDER_EMAIL=CRM <crm@tudominio.com>
SMTP_DOMAIN=tudominio.com
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true
